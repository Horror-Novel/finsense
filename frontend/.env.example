# Copy to ".env.local" (Next.js convention) and fill in real values.
# NEXT_PUBLIC_* vars are baked into the browser bundle at build time.
# Leave blank to use the default proxy (localhost:5000 in dev).

# Only needed if the backend is deployed separately (not on the same host).
# In local dev, Next.js rewrites /api to http://localhost:5000 via next.config.js
NEXT_PUBLIC_API_BASE=

# Optional: enables "Continue with Google" on the login/signup page.
# Use the SAME client ID as GOOGLE_CLIENT_ID in backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
