# ===================================================================
# Copy this file to ".env" in the same folder and fill in real values.
#
# NEVER commit the real ".env" file — it is already listed in .gitignore
# ===================================================================

# --- Server ---

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Postgres (via Prisma) ---

# Local example:
# postgresql://postgres:postgres@localhost:5432/finsense

# If using Docker Compose, this is already set correctly in
# docker-compose.yml

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsense

# --- MongoDB ---

# Local example:
# mongodb://localhost:27017/finsense

# MongoDB Atlas example:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finsense

MONGODB_URI=mongodb://localhost:27017/finsense

# --- Auth ---

# Use a long, random string in production.
#
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Google Gemini API ---

# Get your Gemini API key from Google AI Studio:
# https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used by the application
GEMINI_MODEL=gemini-3.5-flash

# --- Google OAuth (optional — "Continue with Google" login) ---

# Create credentials at https://console.cloud.google.com/apis/credentials
# -> "Create Credentials" -> "OAuth client ID" -> "Web application"
# Add http://localhost:5173 under "Authorized JavaScript origins"
# Leave blank to simply hide the Google sign-in button on the frontend.

GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# --- Redis (optional — caching) ---

# Local example (if you installed Redis yourself):
# redis://localhost:6379

# If using Docker Compose, this is already set correctly in
# docker-compose.yml. Leave blank entirely to run without caching —
# the app works identically either way, just slightly slower on
# repeated dashboard loads.

REDIS_URL=redis://localhost:6379

# --- Rate limiting ---

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
# --- Razorpay (Payment Gateway - optional) ---
# Create an account at https://razorpay.com, go to Settings -> API Keys
# Use TEST mode keys for development (no real money charged).
# Leave blank to disable payment features (Pricing page shows "not configured").
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
